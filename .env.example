# Modèle de configuration — copiez-le en `.env` et remplissez les valeurs.
# Aucune valeur réelle ici : ce fichier est versionné.
#
# Les variables du premier bloc sont vérifiées au démarrage du serveur, et
# leur absence l'interrompt (voir src/lib/env.ts). Les suivantes ne
# concernent qu'une intégration : sans elles, cette intégration est
# désactivée et le reste fonctionne. Une intégration à moitié remplie est
# signalée au démarrage, parce que c'est le cas qui échoue chez un client.

# ---------------------------------------------------------------------------
# Requis
# ---------------------------------------------------------------------------

# Base PostgreSQL. En local, docker-compose.yml expose le service sur 5433.
DATABASE_URL="postgresql://noveris:noveris@localhost:5433/noveris"

# Signature des sessions. Au moins 32 caractères : `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# URL publique de l'application, sans slash final — un slash final casse la
# validation de signature Twilio.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ne renseignez BETTER_AUTH_URL que pour viser une autre origine que
# NEXT_PUBLIC_APP_URL (la configuration Playwright s'en sert pour son port).
# BETTER_AUTH_URL=""

# Domaines supplémentaires depuis lesquels l'application est servie (ex.
# www et apex), séparés par des virgules. Les domaines Vercel du projet
# (déploiement, branche, production) sont déjà acceptés automatiquement.
# BETTER_AUTH_TRUSTED_ORIGINS=""

# Stripe — Developers > API keys, puis `stripe listen` pour le secret webhook.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# Agent vocal IA (standard téléphonique)
# ---------------------------------------------------------------------------

OPENAI_API_KEY=""
# URI SIP du projet OpenAI, vers laquelle Twilio route les appels entrants.
OPENAI_SIP_URI=""
# Vérifie la signature des webhooks Realtime.
OPENAI_WEBHOOK_SECRET=""
# Facultatif : modèle vocal, une valeur par défaut s'applique sinon.
# OPENAI_VOICE_MODEL=""

# ---------------------------------------------------------------------------
# Téléphonie Twilio (achat et routage des numéros)
# ---------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=""
# Sert uniquement à valider la signature des webhooks entrants.
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

# ---------------------------------------------------------------------------
# Agenda Google (prise de rendez-vous)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
# Signe le paramètre `state` du flow OAuth, pour qu'un tiers ne puisse pas
# rattacher sa propre connexion au service d'un autre client.
GOOGLE_OAUTH_STATE_SECRET=""

# ---------------------------------------------------------------------------
# Messagerie Meta (WhatsApp et Messenger)
# ---------------------------------------------------------------------------

# Un seul App Secret Meta valide la signature des trois webhooks.
WHATSAPP_APP_SECRET=""
# Chaîne de votre choix, à recopier à l'identique dans la configuration du
# webhook côté Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Jeton de repli, utilisé tant qu'un client n'a pas connecté son propre compte.
WHATSAPP_ACCESS_TOKEN=""

NEXT_PUBLIC_META_APP_ID=""
# Deux configurations distinctes de la même app Meta, l'une pour WhatsApp,
# l'autre pour Messenger.
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
NEXT_PUBLIC_META_MESSENGER_CONFIG_ID=""

# ---------------------------------------------------------------------------
# Messagerie Instagram
# ---------------------------------------------------------------------------

# App distincte du Meta App ID ci-dessus : App Dashboard > Instagram >
# API setup with Instagram Login.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_OAUTH_REDIRECT_URI="http://localhost:3000/api/instagram/callback"
INSTAGRAM_OAUTH_STATE_SECRET=""

# ---------------------------------------------------------------------------
# E-mails transactionnels (Resend)
# ---------------------------------------------------------------------------

# Sans clé, les envois échouent en silence : ils sont best-effort.
RESEND_API_KEY=""
# Facultatifs, des valeurs par défaut s'appliquent.
# EMAIL_FROM="Automerio <contact@votre-domaine.fr>"
# AUTOMERIO_TEAM_EMAIL=""

# ---------------------------------------------------------------------------
# Limitation de débit répartie (Upstash Redis)
# ---------------------------------------------------------------------------

# Sans Redis, la limitation laisse passer plutôt que de bloquer
# l'authentification. Nécessaire en production : sur Vercel, chaque instance
# aurait sinon son propre compteur, contournable en retombant sur une autre.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------

# Protège la route de relevé d'usage des prestations.
USAGE_EVENTS_API_KEY=""
# Facultatif : prix Stripe de l'offre de maintenance.
# STRIPE_MAINTENANCE_PRICE_ID=""
