generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String          @id
  name                    String
  email                   String
  emailVerified           Boolean         @default(false)
  image                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  stripeCustomerId        String?
  role                    String?         @default("CLIENT")
  banned                  Boolean?        @default(false)
  banReason               String?
  banExpires              DateTime?
  notificationPreferences Json            @default("{}")
  notificationsSeenAt     DateTime?
  twoFactorEnabled        Boolean?        @default(false)
  pendingOrganizationName String?
  twoFactors              TwoFactor[]
  sessions                Session[]
  accounts                Account[]
  clientServices          ClientService[]
  helpRequests            HelpRequest[]
  helpRequestMessages     HelpRequestMessage[]
  auditLogs               AuditLog[]

  members     Member[]
  testCalls               TestCall[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@map("subscription")
}

enum ServiceCategory {
  COMMUNICATION
  ADMINISTRATION
  INFORMATION
  ABONNEMENT
}

enum UsageUnit {
  CALL
  MINUTE
}

model Service {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  description       String
  category          ServiceCategory
  monthlyPriceCents Int?

  // Plafond d'usage inclus dans l'abonnement. Les trois champs vont ensemble :
  // sans unite ni quantite, la solution n'a pas de plafond. L'etiquette lue par
  // le client (« 150 min incluses, puis 0,30 EUR/min ») en est derivee
  // (`formatUsageCap`), pour qu'elle ne puisse pas contredire la jauge.
  includedUsageUnits    Int?
  usageUnit             UsageUnit?
  overageUnitPriceCents Int?

  // Bornes du curseur par lequel le client choisit son quota.
  // `includedUsageUnits` en est le plancher et correspond a
  // `monthlyPriceCents` : rester au minimum coute le prix affiche au catalogue.
  // Sans `maxUsageUnits`, la solution n'est pas personnalisable.
  maxUsageUnits         Int?
  usageStepUnits        Int?

  // Ce que coute une unite ajoutee au quota. Doit rester sous
  // `overageUnitPriceCents`, sinon le client n'a aucune raison d'acheter a
  // l'avance plutot que de payer son depassement.
  extraUnitPriceCents   Int?

  configFields      Json            @default("[]")
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)

  // Date de derniere modification, publiee en `lastmod` dans le sitemap. Les
  // moteurs ignorent une date qu'ils jugent peu fiable : elle doit donc suivre
  // les vraies editions du catalogue, pas la date de deploiement.
  updatedAt         DateTime        @updatedAt
  clientServices    ClientService[]
  marketingPosts    MarketingPost[]

  @@map("service")
}

enum ClientServiceStatus {
  PENDING_PAYMENT
  CONFIGURING
  ACTIVE
  CANCELED
}

model ClientService {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                    String
  serviceId               String
  service                 Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status                  ClientServiceStatus @default(PENDING_PAYMENT)
  configuration           Json                @default("{}")

  // Le quota choisi a la commande et le prix convenu alors. Nuls quand la
  // solution n'est pas personnalisable : les valeurs du catalogue font foi.
  // Le prix est fige a l'achat — un changement de tarif ne doit pas modifier
  // retroactivement ce qu'un client paie deja.
  includedUsageUnits      Int?
  monthlyPriceCents       Int?
  adminNote               String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeSubscriptionId    String?
  externalPhoneNumber     String?
  externalPhoneNumberSid  String?
  whatsappPhoneNumberId    String?
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  whatsappDisplayNumber     String?
  facebookPageId           String?
  facebookPageAccessToken  String?
  facebookPageName         String?
  instagramAccountId       String?
  instagramAccessToken     String?
  instagramTokenExpiresAt  DateTime?
  instagramUsername        String?
  promoCode                String?
  paymentFailedAt          DateTime?
  activatedAt             DateTime?
  canceledAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  usageEvents        UsageEvent[]
  calendarConnection CalendarConnection?
  bookings           Booking[]
  conversations      Conversation[]
  testCalls          TestCall[]
  events             ServiceEvent[]
  helpRequests       HelpRequest[]

  @@unique([organizationId, serviceId, name])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("client_service")
}

enum ServiceEventType {
  CREATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ACTIVATED
  NOTE_ADDED
  PHONE_ASSIGNED
  CALENDAR_CONNECTED
  CALENDAR_DISCONNECTED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
  FACEBOOK_CONNECTED
  FACEBOOK_DISCONNECTED
  INSTAGRAM_CONNECTED
  INSTAGRAM_DISCONNECTED
  CONFIGURATION_UPDATED
  QUOTA_CHANGED
  QUOTA_WARNING
  QUOTA_EXCEEDED
  CANCELED
}

model ServiceEvent {
  id              String           @id @default(cuid())
  clientServiceId String
  clientService   ClientService    @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            ServiceEventType
  message         String?
  createdAt       DateTime         @default(now())

  @@index([clientServiceId, createdAt])
  @@map("service_event")
}

model CalendarConnection {
  id                   String        @id @default(cuid())
  clientServiceId      String        @unique
  clientService        ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  googleAccountEmail   String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  calendarId           String        @default("primary")
  scope                String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("calendar_connection")
}

model Booking {
  id              String        @id @default(cuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  kind            String
  customerName    String
  customerPhone   String
  startAt         DateTime?
  endAt           DateTime?
  googleEventId   String?
  notes           String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([clientServiceId, createdAt])
  @@map("booking")
}

model UsageEvent {
  id              String        @id @default(cuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            String        @default("call")
  status          String        @default("completed")
  occurredAt      DateTime
  endedAt         DateTime?
  durationSec     Int?
  externalId      String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())
  callSummary     CallSummary?

  @@index([clientServiceId, occurredAt])
  @@index([clientServiceId, status])
  @@map("usage_event")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  activity  String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_message")
}

enum HelpRequestStatus {
  OPEN
  RESOLVED
}

model HelpRequest {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientServiceId String?
  clientService   ClientService?    @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  subject         String
  message         String
  status          HelpRequestStatus @default(OPEN)
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?

  messages HelpRequestMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("help_request")
}

model HelpRequestMessage {
  id            String      @id @default(cuid())
  helpRequestId String
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromTeam      Boolean
  body          String
  createdAt     DateTime    @default(now())

  @@index([helpRequestId, createdAt])
  @@map("help_request_message")
}

model Organization {
  id             String          @id
  name           String
  slug           String
  logo           String?
  createdAt      DateTime
  metadata       String?

  // Le client Stripe de l'entreprise, non de la personne qui a commande. Une
  // prestation appartient a une organisation et se partage entre ses membres :
  // ses factures doivent suivre la meme frontiere. Cree a la premiere commande
  // seulement — une entreprise qui n'achete rien n'encombre pas Stripe.
  stripeCustomerId String?        @unique
  members        Member[]
  invitations    Invitation[]
  clientServices ClientService[]
  helpRequests   HelpRequest[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum AuditAction {
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  USER_PASSWORD_RESET
  USER_SESSION_REVOKED
  SERVICE_UPDATED
  SERVICE_ACTIVATED
  SERVICE_DEACTIVATED
  PROMO_CODE_CREATED
  PROMO_CODE_DEACTIVATED
}

model AuditLog {
  id      String      @id @default(cuid())
  actorId String
  actor   User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action  AuditAction
  actorLabel  String
  targetType  String
  targetId    String
  targetLabel String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum MarketingChannel {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum MarketingPostStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}

model MarketingPost {
  id      String              @id @default(cuid())
  channel MarketingChannel
  status  MarketingPostStatus @default(DRAFT)

  angle String
  body  String

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  imageBrief String?

  warnings String[] @default([])

  scheduledFor DateTime?
  publishedAt  DateTime?
  externalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("marketing_post")
}

enum DemoCallStatus {
  REQUESTED
  CALLING
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Appel d'essai demande depuis le site public. Le numero n'est jamais stocke
/// en clair : seule son empreinte HMAC sert a n'accorder qu'un essai par numero.
model DemoCall {
  id            String         @id @default(cuid())
  phoneHash     String         @unique
  ipHash        String
  serviceSlug   String
  status        DemoCallStatus @default(REQUESTED)
  twilioCallSid String?        @unique
  openaiCallId  String?        @unique
  durationSec   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@map("demo_call")
}

/// Ce qui s'est dit pendant un appel traite par l'agent vocal, et son resume.
/// Genere a la fin de l'appel ; absent si l'appel n'a rien produit d'intelligible.
model CallSummary {
  id           String     @id @default(cuid())
  usageEventId String     @unique
  usageEvent   UsageEvent @relation(fields: [usageEventId], references: [id], onDelete: Cascade)
  /// Les tours de parole, dans l'ordre : [{ speaker: "caller" | "assistant", text }]
  transcript   Json
  reason       String?
  summary      String?
  followUp     String?
  callerName   String?
  createdAt    DateTime   @default(now())

  @@map("call_summary")
}

enum MessagingChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Un fil d'echanges entre l'assistant d'une solution de messagerie et un
/// contact, sur un canal. Supprime avec la solution.
model Conversation {
  id              String                @id @default(cuid())
  clientServiceId String
  clientService   ClientService         @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  channel         MessagingChannel
  /// L'identifiant du contact chez Meta : numero WhatsApp, ou identifiant de page.
  contactId       String
  lastMessageAt   DateTime              @default(now())
  createdAt       DateTime              @default(now())
  messages        ConversationMessage[]

  @@unique([clientServiceId, channel, contactId])
  @@index([clientServiceId, lastMessageAt])
  @@map("conversation")
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  text           String
  /// L'identifiant du message chez Meta, pour ignorer un webhook renvoye.
  externalId     String?          @unique
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_message")
}

/// Appel de test demande par un client depuis son tableau de bord : l'agent
/// l'appelle avec la configuration de sa solution, sans rien enregistrer.
model TestCall {
  id              String         @id @default(cuid())
  clientServiceId String
  clientService   ClientService  @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status          DemoCallStatus @default(REQUESTED)
  twilioCallSid   String?        @unique
  openaiCallId    String?        @unique
  durationSec     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientServiceId, createdAt])
  @@map("test_call")
}
