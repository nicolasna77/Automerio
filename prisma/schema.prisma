generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id
  name                    String
  email                   String
  emailVerified           Boolean              @default(false)
  image                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  stripeCustomerId        String?
  role                    String?              @default("CLIENT")
  banned                  Boolean?             @default(false)
  banReason               String?
  banExpires              DateTime?
  notificationPreferences Json                 @default("{}")
  notificationsSeenAt     DateTime?
  twoFactorEnabled        Boolean?             @default(false)
  pendingOrganizationName String?
  twoFactors              TwoFactor[]
  sessions                Session[]
  accounts                Account[]
  clientServices          ClientService[]
  helpRequests            HelpRequest[]
  helpRequestMessages     HelpRequestMessage[]
  auditLogs               AuditLog[]

  members             Member[]
  testCalls           TestCall[]
  conversationReplies ConversationMessage[]
  invitations         Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@map("subscription")
}

enum ServiceCategory {
  COMMUNICATION
  ADMINISTRATION
  INFORMATION
  ABONNEMENT
}

enum UsageUnit {
  CALL
  MINUTE
  MESSAGE
}

model Service {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  description       String
  category          ServiceCategory
  monthlyPriceCents Int?

  includedUsageUnits    Int?
  usageUnit             UsageUnit?
  overageUnitPriceCents Int?

  maxUsageUnits  Int?
  usageStepUnits Int?

  extraUnitPriceCents Int?

  configFields Json    @default("[]")
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  updatedAt      DateTime        @updatedAt
  clientServices ClientService[]
  marketingPosts MarketingPost[]

  @@map("service")
}

enum ClientServiceStatus {
  PENDING_PAYMENT
  CONFIGURING
  ACTIVE
  CANCELED
}

model ClientService {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  serviceId      String
  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status         ClientServiceStatus @default(PENDING_PAYMENT)
  configuration  Json                @default("{}")

  includedUsageUnits        Int?
  // Dépassement du quota accepté par le client. Refusé par défaut : une fois
  // le quota atteint, l'assistant se met en pause jusqu'à la période suivante.
  overageAllowed            Boolean   @default(false)
  // Pause décidée par le client : l'assistant ne décroche plus et ne répond
  // plus aux messages tant qu'elle n'est pas levée.
  pausedAt                  DateTime?
  monthlyPriceCents         Int?
  adminNote                 String?
  stripeCheckoutSessionId   String?
  stripePaymentIntentId     String?
  stripeSubscriptionId      String?
  externalPhoneNumber       String?
  externalPhoneNumberSid    String?
  whatsappPhoneNumberId     String?   @unique
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  whatsappDisplayNumber     String?
  facebookPageId            String?   @unique
  facebookPageAccessToken   String?
  facebookPageName          String?
  instagramAccountId        String?   @unique
  instagramAccessToken      String?
  instagramTokenExpiresAt   DateTime?
  instagramUsername         String?
  promoCode                 String?
  paymentFailedAt           DateTime?
  activatedAt               DateTime?
  canceledAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  usageEvents          UsageEvent[]
  calendarConnection   CalendarConnection?
  schedulingConnection SchedulingConnection?
  bookings             Booking[]
  conversations        Conversation[]
  testCalls            TestCall[]
  events               ServiceEvent[]
  helpRequests         HelpRequest[]

  @@unique([organizationId, serviceId, name])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("client_service")
}

enum ServiceEventType {
  CREATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ACTIVATED
  NOTE_ADDED
  PHONE_ASSIGNED
  CALENDAR_CONNECTED
  CALENDAR_DISCONNECTED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
  FACEBOOK_CONNECTED
  FACEBOOK_DISCONNECTED
  INSTAGRAM_CONNECTED
  INSTAGRAM_DISCONNECTED
  CONFIGURATION_UPDATED
  QUOTA_CHANGED
  QUOTA_WARNING
  QUOTA_EXCEEDED
  OVERAGE_ACCEPTED
  OVERAGE_REFUSED
  PAUSED
  RESUMED
  CANCELED
}

model ServiceEvent {
  id              String           @id @default(cuid())
  clientServiceId String
  clientService   ClientService    @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            ServiceEventType
  message         String?
  createdAt       DateTime         @default(now())

  @@index([clientServiceId, createdAt])
  @@map("service_event")
}

model CalendarConnection {
  id                   String        @id @default(cuid())
  clientServiceId      String        @unique
  clientService        ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  googleAccountEmail   String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  calendarId           String        @default("primary")
  scope                String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("calendar_connection")
}

// Outil de prise de rendez-vous tiers (Cal.com, Calendly), branché par clé
// API. Une solution n'a qu'un agenda : en connecter un retire l'autre.
model SchedulingConnection {
  id              String        @id @default(cuid())
  clientServiceId String        @unique
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  // "calcom" ou "calendly"
  provider        String
  // Clé API ou jeton personnel, chiffré (src/lib/secret-box.ts).
  encryptedToken  String
  accountLabel    String
  // Identifiant Cal.com ou URI Calendly du type de rendez-vous réservé.
  eventTypeId     String
  eventTypeName   String
  durationMinutes Int
  // Calendly : lieu du type de rendez-vous ({ kind, location? }), renvoyé
  // tel quel à la réservation, qui doit le reprendre.
  location        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("scheduling_connection")
}

model Booking {
  id                String        @id @default(cuid())
  clientServiceId   String
  clientService     ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  kind              String
  customerName      String
  customerPhone     String
  startAt           DateTime?
  endAt             DateTime?
  googleEventId     String?
  // Réservation créée chez Cal.com ou Calendly.
  externalBookingId String?
  notes             String?
  metadata          Json?
  createdAt         DateTime      @default(now())

  @@index([clientServiceId, createdAt])
  @@map("booking")
}

model UsageEvent {
  id              String        @id @default(cuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            String        @default("call")
  status          String        @default("completed")
  occurredAt      DateTime
  endedAt         DateTime?
  durationSec     Int?
  externalId      String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())
  handledAt       DateTime?
  callSummary     CallSummary?

  @@index([clientServiceId, occurredAt])
  @@index([clientServiceId, status])
  @@map("usage_event")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  activity  String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_message")
}

enum HelpRequestStatus {
  OPEN
  RESOLVED
}

model HelpRequest {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientServiceId String?
  clientService   ClientService?    @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  subject         String
  message         String
  status          HelpRequestStatus @default(OPEN)
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?

  messages HelpRequestMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("help_request")
}

model HelpRequestMessage {
  id            String      @id @default(cuid())
  helpRequestId String
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromTeam      Boolean
  body          String
  createdAt     DateTime    @default(now())

  @@index([helpRequestId, createdAt])
  @@map("help_request_message")
}

model Organization {
  id        String   @id
  name      String
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?

  stripeCustomerId   String?         @unique
  lastWeeklyDigestAt DateTime?
  members            Member[]
  invitations        Invitation[]
  clientServices     ClientService[]
  helpRequests       HelpRequest[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum AuditAction {
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  USER_PASSWORD_RESET
  USER_SESSION_REVOKED
  SERVICE_UPDATED
  SERVICE_ACTIVATED
  SERVICE_DEACTIVATED
  PROMO_CODE_CREATED
  PROMO_CODE_DEACTIVATED
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      AuditAction
  actorLabel  String
  targetType  String
  targetId    String
  targetLabel String
  detail      String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum MarketingChannel {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum MarketingPostStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}

model MarketingPost {
  id      String              @id @default(cuid())
  channel MarketingChannel
  status  MarketingPostStatus @default(DRAFT)

  angle String
  body  String

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  imageBrief String?

  warnings String[] @default([])

  scheduledFor DateTime?
  publishedAt  DateTime?
  externalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("marketing_post")
}

enum DemoCallStatus {
  REQUESTED
  CALLING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model DemoCall {
  id            String         @id @default(cuid())
  phoneHash     String         @unique
  ipHash        String
  serviceSlug   String
  status        DemoCallStatus @default(REQUESTED)
  twilioCallSid String?        @unique
  openaiCallId  String?        @unique
  durationSec   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@map("demo_call")
}

model CallSummary {
  id           String     @id @default(cuid())
  usageEventId String     @unique
  usageEvent   UsageEvent @relation(fields: [usageEventId], references: [id], onDelete: Cascade)
  transcript   Json
  reason       String?
  summary      String?
  followUp     String?
  callerName   String?
  createdAt    DateTime   @default(now())

  @@map("call_summary")
}

enum MessagingChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Conversation {
  id              String                @id @default(cuid())
  clientServiceId String
  clientService   ClientService         @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  channel         MessagingChannel
  contactId       String
  lastMessageAt   DateTime              @default(now())
  // Dernier message du contact : Meta n'autorise une réponse libre que dans
  // les 24 h qui suivent.
  lastInboundAt   DateTime?
  // Renseignée quand le client a repris la main : l'assistant ne répond plus
  // dans cette conversation jusqu'à ce qu'on la lui rende.
  humanTakeoverAt DateTime?
  createdAt       DateTime              @default(now())
  messages        ConversationMessage[]

  @@unique([clientServiceId, channel, contactId])
  @@index([clientServiceId, lastMessageAt])
  @@map("conversation")
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  text           String
  externalId     String?          @unique
  // Réponse écrite par un membre de l'organisation ; vide pour l'assistant.
  sentById       String?
  sentBy         User?            @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_message")
}

model TestCall {
  id              String         @id @default(cuid())
  clientServiceId String
  clientService   ClientService  @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     User           @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status          DemoCallStatus @default(REQUESTED)
  twilioCallSid   String?        @unique
  openaiCallId    String?        @unique
  durationSec     Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientServiceId, createdAt])
  @@map("test_call")
}

model WaitlistEntry {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  company             String?
  phone               String?
  wantsCallback       Boolean   @default(false)
  wantsNewsletter     Boolean   @default(false)
  newsletterConsentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([createdAt])
  @@map("waitlist_entry")
}
