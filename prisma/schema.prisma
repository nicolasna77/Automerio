generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String          @id
  name                    String
  email                   String
  emailVerified           Boolean         @default(false)
  image                   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  stripeCustomerId        String?
  role                    String?         @default("CLIENT")
  banned                  Boolean?        @default(false)
  banReason               String?
  banExpires              DateTime?
  notificationPreferences Json            @default("{}")
  notificationsSeenAt     DateTime?
  twoFactorEnabled        Boolean?        @default(false)
  pendingOrganizationName String?
  twoFactors              TwoFactor[]
  sessions                Session[]
  accounts                Account[]
  clientServices          ClientService[]
  helpRequests            HelpRequest[]
  helpRequestMessages     HelpRequestMessage[]
  auditLogs               AuditLog[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@map("subscription")
}

enum ServiceCategory {
  COMMUNICATION
  ADMINISTRATION
  INFORMATION
  ABONNEMENT
}

enum UsageUnit {
  CALL
  MINUTE
}

model Service {
  id                String          @id @default(cuid())
  slug              String          @unique
  name              String
  description       String
  category          ServiceCategory
  setupFeeCents     Int?
  monthlyPriceCents Int?

  // Plafond d'usage inclus dans l'abonnement. Les trois champs vont ensemble :
  // sans unite ni quantite, la solution n'a pas de plafond. L'etiquette lue par
  // le client (« 150 min incluses, puis 0,30 EUR/min ») en est derivee
  // (`formatUsageCap`), pour qu'elle ne puisse pas contredire la jauge.
  includedUsageUnits    Int?
  usageUnit             UsageUnit?
  overageUnitPriceCents Int?

  configFields      Json            @default("[]")
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  clientServices    ClientService[]
  marketingPosts    MarketingPost[]

  @@map("service")
}

enum ClientServiceStatus {
  PENDING_PAYMENT
  CONFIGURING
  ACTIVE
  CANCELED
}

model ClientService {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                    String
  serviceId               String
  service                 Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status                  ClientServiceStatus @default(PENDING_PAYMENT)
  configuration           Json                @default("{}")
  adminNote               String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeSubscriptionId    String?
  externalPhoneNumber     String?
  externalPhoneNumberSid  String?
  whatsappPhoneNumberId    String?
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  whatsappDisplayNumber     String?
  facebookPageId           String?
  facebookPageAccessToken  String?
  facebookPageName         String?
  instagramAccountId       String?
  instagramAccessToken     String?
  instagramTokenExpiresAt  DateTime?
  instagramUsername        String?
  promoCode                String?
  paymentFailedAt          DateTime?
  activatedAt             DateTime?
  canceledAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  usageEvents        UsageEvent[]
  calendarConnection CalendarConnection?
  bookings           Booking[]
  events             ServiceEvent[]
  helpRequests       HelpRequest[]

  @@unique([organizationId, serviceId, name])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("client_service")
}

enum ServiceEventType {
  CREATED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  ACTIVATED
  NOTE_ADDED
  PHONE_ASSIGNED
  CALENDAR_CONNECTED
  CALENDAR_DISCONNECTED
  WHATSAPP_CONNECTED
  WHATSAPP_DISCONNECTED
  FACEBOOK_CONNECTED
  FACEBOOK_DISCONNECTED
  INSTAGRAM_CONNECTED
  INSTAGRAM_DISCONNECTED
  CONFIGURATION_UPDATED
  CANCELED
}

model ServiceEvent {
  id              String           @id @default(cuid())
  clientServiceId String
  clientService   ClientService    @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            ServiceEventType
  message         String?
  createdAt       DateTime         @default(now())

  @@index([clientServiceId, createdAt])
  @@map("service_event")
}

model CalendarConnection {
  id                   String        @id @default(cuid())
  clientServiceId      String        @unique
  clientService        ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  googleAccountEmail   String
  accessToken          String
  refreshToken         String
  accessTokenExpiresAt DateTime
  calendarId           String        @default("primary")
  scope                String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("calendar_connection")
}

model Booking {
  id              String        @id @default(cuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  kind            String
  customerName    String
  customerPhone   String
  startAt         DateTime?
  endAt           DateTime?
  googleEventId   String?
  notes           String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([clientServiceId, createdAt])
  @@map("booking")
}

model UsageEvent {
  id              String        @id @default(cuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  type            String        @default("call")
  status          String        @default("completed")
  occurredAt      DateTime
  endedAt         DateTime?
  durationSec     Int?
  externalId      String?       @unique
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([clientServiceId, occurredAt])
  @@index([clientServiceId, status])
  @@map("usage_event")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  activity  String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_message")
}

enum HelpRequestStatus {
  OPEN
  RESOLVED
}

model HelpRequest {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientServiceId String?
  clientService   ClientService?    @relation(fields: [clientServiceId], references: [id], onDelete: SetNull)
  subject         String
  message         String
  status          HelpRequestStatus @default(OPEN)
  createdAt       DateTime          @default(now())
  resolvedAt      DateTime?

  messages HelpRequestMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([organizationId])
  @@map("help_request")
}

model HelpRequestMessage {
  id            String      @id @default(cuid())
  helpRequestId String
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromTeam      Boolean
  body          String
  createdAt     DateTime    @default(now())

  @@index([helpRequestId, createdAt])
  @@map("help_request_message")
}

model Organization {
  id             String          @id
  name           String
  slug           String
  logo           String?
  createdAt      DateTime
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  clientServices ClientService[]
  helpRequests   HelpRequest[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum AuditAction {
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  USER_PASSWORD_RESET
  USER_SESSION_REVOKED
  SERVICE_UPDATED
  SERVICE_ACTIVATED
  SERVICE_DEACTIVATED
  PROMO_CODE_CREATED
  PROMO_CODE_DEACTIVATED
}

model AuditLog {
  id      String      @id @default(cuid())
  actorId String
  actor   User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action  AuditAction
  actorLabel  String
  targetType  String
  targetId    String
  targetLabel String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum MarketingChannel {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
}

enum MarketingPostStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}

model MarketingPost {
  id      String              @id @default(cuid())
  channel MarketingChannel
  status  MarketingPostStatus @default(DRAFT)

  angle String
  body  String

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  imageBrief String?

  warnings String[] @default([])

  scheduledFor DateTime?
  publishedAt  DateTime?
  externalId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("marketing_post")
}
